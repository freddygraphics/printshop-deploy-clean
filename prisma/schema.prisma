generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  country   String?
  zip       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  invoices  Invoice[]
  jobs      Job[]
  notes     Note[]
  orders    Order[]
  quotes    Quote[]
}

model StickerSheetPricing {
  id           String   @id @default(cuid())
  name         String   @unique
  costPerSheet Float
  laminateCost Float
  cutCost      Float
  wastePercent Float    @default(10)
  profitMargin Float    @default(40)
  createdAt    DateTime @default(now())
  sheetHeight  Float    @default(17)
  sheetWidth   Float    @default(11)
}

model RaffleTicketPricing {
  id                       String   @id @default(cuid())
  paperCostPerSheet        Float    @default(0.45)
  printingCostPerSheet     Float    @default(0.55)
  cutCostPerSheet          Float    @default(0.20)
  ticketsPerSheet          Int      @default(8)
  wastePercent             Float    @default(10)
  setupFee                 Float    @default(10)
  numberingSetupFee        Float    @default(10)
  numberingCostPerTicket   Float    @default(0.02)
  perforationSetupFee      Float    @default(10)
  perforationCostPerTicket Float    @default(0.03)
  bookletCost              Float    @default(2)
  defaultTicketsPerBook    Int      @default(50)
  printReadyDesignFee      Float    @default(0)
  basicDesignFee           Float    @default(25)
  fullDesignFee            Float    @default(50)
  profitMargin             Float    @default(50)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model PrintProduct {
  id         String   @id @default(cuid())
  name       String
  sinaliteId Int
  options    Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  sku         String? @unique
  description String?

  // EXISTENTE — NO TOCAR
  category       String?
  relatedService String?

  // NUEVO SISTEMA DE CATEGORÍAS
  categoryId      Int?
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id])

  pricingMode    String @default("manual")
  basePrice      Float  @default(0)
  defaultOptions Json?
  customFields   Json?

  // TEMPORAL
  // Más adelante lo renombraremos a configuratorType
  templateType String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  profitMargin    Float    @default(1.5)
  sinaliteEnabled Boolean  @default(false)
  sinaliteId      Int?
  sinaliteOptions Json?
  image           String?
  showOnWebsite   Boolean  @default(false)

  images        ProductImage[]
  invoiceItems  InvoiceItem[]
  orders        Order[]
  quoteItems    QuoteItem[]
  quoteRequests QuoteRequest[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductCategory {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  active   Boolean @default(true)
  position Int     @default(0)

  // Para mantener compatibilidad con la website
  relatedService String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrintProductionProfile {
  id           String        @id @default(cuid())
  name         String
  machine      String
  processId    String
  materialId   String
  minWidth     Float
  maxWidth     Float
  minHeight    Float
  maxHeight    Float
  allowKissCut Boolean       @default(false)
  allowDieCut  Boolean       @default(false)
  laminationId String?
  wastePercent Float         @default(10)
  setupCost    Float         @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]
  lamination   Finish?       @relation(fields: [laminationId], references: [id])
  material     Material      @relation(fields: [materialId], references: [id])
  process      Process       @relation(fields: [processId], references: [id])
  quoteItems   QuoteItem[]
}

model Quote {
  id            Int         @id @default(autoincrement())
  quoteNumber   Int?        @unique
  clientId      Int?
  quoteDate     DateTime    @default(now())
  validUntil    DateTime?
  subtotal      Float       @default(0)
  tax           Float       @default(0)
  total         Float       @default(0)
  paymentOption String      @default("full")
  status        String      @default("Pending")
  notes         String?
  reference     String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customerNotes String?
  internalNotes String?
  userId        Int?
  pdfStatus     String?     @default("pending")
  pdfUpdatedAt  DateTime?
  invoices      Invoice[]
  client        Client?     @relation(fields: [clientId], references: [id])
  user          User?       @relation(fields: [userId], references: [id])
  items         QuoteItem[]
}

model QuoteRequest {
  id           String             @id @default(cuid())
  name         String
  email        String
  phone        String?
  productId    Int?
  productName  String
  options      Json
  notes        String?
  status       QuoteRequestStatus @default(NEW)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  qty          Int                @default(1)
  businessName String?
  product      Product?           @relation(fields: [productId], references: [id])
}

model Counter {
  name  String @id
  value Int
}

model QuoteItem {
  id                       Int                     @id @default(autoincrement())
  quoteId                  Int
  productId                Int?
  printProductionProfileId String?
  name                     String
  qty                      Int
  unitPrice                Float
  total                    Float
  options                  Json?
  notes                    String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  printProductionProfile   PrintProductionProfile? @relation(fields: [printProductionProfileId], references: [id])
  product                  Product?                @relation(fields: [productId], references: [id])
  quote                    Quote                   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Invoice {
  id               Int               @id @default(autoincrement())
  clientId         Int
  quoteId          Int?
  subtotal         Float             @default(0)
  tax              Float             @default(0)
  taxRate          Float             @default(6.625)
  taxEnabled       Boolean           @default(true)
  total            Float             @default(0)
  applyTax         Boolean           @default(true)
  squareLinkId     String?
  squareOrderId    String?           @unique
  squarePaymentId  String?
  paymentStatus    String            @default("Unpaid")
  issuedAt         DateTime
  dueDate          DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userId           Int?
  invoiceNumber    Int               @unique
  publicToken      String            @unique
  discountAmount   Float             @default(0)
  paidAt           DateTime?
  balance          Float             @default(0)
  status           InvoiceStatus     @default(DRAFT)
  voidReason       String?
  voidedAt         DateTime?
  pdfGeneratedAt   DateTime?
  pdfUrl           String?
  pdfStatus        String            @default("idle")
  pdfUpdatedAt     DateTime?
  client           Client            @relation(fields: [clientId], references: [id])
  quote            Quote?            @relation(fields: [quoteId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  appliedDiscounts InvoiceDiscount[]
  invoiceItems     InvoiceItem[]
  payments         InvoicePayment[]
  job              Job?
  orders           Order[]
  paymentIntents   PaymentIntent[]
}

model PaymentIntent {
  id            String   @id @default(cuid())
  invoiceId     Int
  amount        Float
  processingFee Float
  totalCharged  Float
  method        String
  type          String   @default("full")
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
}

model InvoiceItem {
  id                       Int                     @id @default(autoincrement())
  invoiceId                Int
  productId                Int?
  printProductionProfileId String?
  name                     String
  qty                      Int
  unitPrice                Float
  total                    Float
  pricingMode              String                  @default("manual")
  widthIn                  Float?
  heightIn                 Float?
  sqft                     Float?
  priceSnapshot            Json?
  options                  Json?
  notes                    String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  totalCost                Float?
  invoice                  Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  printProductionProfile   PrintProductionProfile? @relation(fields: [printProductionProfileId], references: [id])
  product                  Product?                @relation(fields: [productId], references: [id])
}

model Order {
  id           Int       @id @default(autoincrement())
  tenantId     Int?
  productId    Int?
  clientId     Int?
  invoiceId    Int?
  status       String    @default("Design")
  workflow     Json?
  customFields Json?
  priority     String?   @default("Normal")
  assignedTo   String?
  notes        String?
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client?   @relation(fields: [clientId], references: [id])
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id])
  product      Product?  @relation(fields: [productId], references: [id])
}

model Note {
  id        Int      @id @default(autoincrement())
  clientId  Int
  type      String   @default("note")
  content   String
  createdAt DateTime @default(now())
  createdBy String?
  client    Client   @relation(fields: [clientId], references: [id])
}

model Job {
  id                  Int       @id @default(autoincrement())
  jobNumber           Int       @unique
  clientId            Int
  status              JobStatus @default(Pending)
  description         String?
  dueDate             DateTime?
  notes               String?
  salesRepId          Int?
  productionManagerId Int?
  projectManagerId    Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  invoiceId           Int       @unique
  position            Int       @default(0)
  pickupToken         String?   @unique
  pickedUpAt          DateTime?
  pickedUpBy          String?
  archived            Boolean   @default(false)
  archivedAt          DateTime?
  deliveredAt         DateTime?
  client              Client    @relation(fields: [clientId], references: [id])
  invoice             Invoice   @relation(fields: [invoiceId], references: [id])
  files               JobFile[]
  items               JobItem[]
}

model JobItem {
  id        Int    @id @default(autoincrement())
  jobId     Int
  name      String
  qty       Int
  unitPrice Float
  total     Float
  job       Job    @relation(fields: [jobId], references: [id])
}

model InvoicePayment {
  id              Int      @id @default(autoincrement())
  invoiceId       Int
  amount          Float
  processingFee   Float    @default(0)
  method          String
  squarePaymentId String?  @unique
  note            String?
  paidAt          DateTime @default(now())
  createdAt       DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Settings {
  id                    Int      @id @default(autoincrement())
  taxEnabled            Boolean  @default(true)
  defaultTaxRate        Float    @default(0)
  allowDiscounts        Boolean  @default(true)
  maxDiscountPercent    Float    @default(100)
  paymentFeePercent     Float    @default(0)
  paymentFeeFlat        Float    @default(0)
  applyFeeToCustomer    Boolean  @default(false)
  defaultTerms          String   @default("Due on receipt")
  defaultDepositPercent Float    @default(0)
  defaultCustomerNotes  String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
  discountRules         Json     @default("[]")
  paymentFees           Json     @default("[]")
}

model Discount {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   @default("percent")
  value       Float
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String    @default("staff")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  quotes    Quote[]
}

model InvoiceDiscount {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  discountId Int
  type       String
  value      Float
  amount     Float
  createdAt  DateTime @default(now())
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
}

model JobFile {
  id        Int      @id @default(autoincrement())
  jobId     Int
  name      String
  url       String
  type      String
  createdAt DateTime @default(now())
  isDefault Boolean  @default(false)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Material {
  id                      String                   @id @default(cuid())
  name                    String
  category                String
  unitType                String
  rollWidthIn             Float?
  rollLengthFt            Float?
  sheetWidthIn            Float?
  sheetHeightIn           Float?
  rollCost                Float?
  wastePercent            Float?
  costPerSqft             Float
  sellPerSqft             Float
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  printProductionProfiles PrintProductionProfile[]
}

model Process {
  id                      String                   @id @default(cuid())
  name                    String
  category                String
  costPerSqft             Float
  sellPerSqft             Float
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  printProductionProfiles PrintProductionProfile[]
}

model Finish {
  id                      String                   @id @default(cuid())
  name                    String
  unitType                String
  sellPrice               Float
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  printProductionProfiles PrintProductionProfile[]
}

model PrintSettings {
  id                 String   @id @default(cuid())
  stickerRollPrice   Float
  stickerRollWidth   Float
  stickerRollLength  Float
  laminateRollPrice  Float
  laminateRollWidth  Float
  laminateRollLength Float
  laborPerHour       Float
  profitMargin       Float
  createdAt          DateTime @default(now())
}

model SheetSize {
  id        String   @id @default(cuid())
  name      String
  width     Float
  height    Float
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PrintPricingSettings {
  id                  String   @id @default(cuid())
  vinylRollPrice      Float
  vinylRollWidth      Float
  vinylRollLength     Float
  laminateRollPrice   Float
  laminateRollWidth   Float
  laminateRollLength  Float
  laborPerHour        Float
  profitMargin        Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  cuttingCostPerSheet Float    @default(0)
  inkCostPerSqft      Float    @default(0)
  machineCostPerHour  Float    @default(0)
  minimumStickerPrice Float    @default(0)
  setupFee            Float    @default(0)
  wastePercent        Float    @default(0)
}

model CounterSaleProduct {
  id        Int                  @id @default(autoincrement())
  category  String
  name      String
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  items     CounterSaleItem[]
  variants  CounterSaleVariant[]
}

model CounterSaleVariant {
  id        Int                @id @default(autoincrement())
  productId Int
  size      String
  sides     String?
  paperType String?
  finish    String?
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  items     CounterSaleItem[]
  tiers     CounterSaleTier[]
  product   CounterSaleProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CounterSaleTier {
  id        Int                @id @default(autoincrement())
  variantId Int
  minQty    Int
  maxQty    Int?
  unitPrice Float
  createdAt DateTime           @default(now())
  variant   CounterSaleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model CounterSale {
  id        Int               @id @default(autoincrement())
  total     Float
  saleDate  DateTime          @default(now())
  createdAt DateTime          @default(now())
  items     CounterSaleItem[]
}

model CounterSaleItem {
  id        Int                @id @default(autoincrement())
  saleId    Int
  productId Int
  variantId Int
  quantity  Int
  unitPrice Float
  total     Float
  product   CounterSaleProduct @relation(fields: [productId], references: [id])
  sale      CounterSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant   CounterSaleVariant @relation(fields: [variantId], references: [id])
}

model ProductOptionLibrary {
  id        String   @id @default(cuid())
  name      String
  key       String
  type      String
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApparelProduct {
  id            Int              @id @default(autoincrement())
  supplier      String           @default("SanMar")
  supplierStyle String
  name          String
  description   String?
  brand         String?
  category      String?
  subcategory   String?
  imageUrl      String?
  active        Boolean          @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variants      ApparelVariant[]

  @@unique([supplier, supplierStyle])
  @@index([name])
  @@index([brand])
  @@index([category])
}

model ApparelVariant {
  id              Int            @id @default(autoincrement())
  productId       Int
  supplierSku     String         @unique
  color           String
  colorCode       String?
  size            String
  supplierPrice   Float          @default(0)
  inventory       Int            @default(0)
  warehouseData   Json?
  active          Boolean        @default(true)
  lastInventoryAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  product         ApparelProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([color])
  @@index([size])
}

model ApparelPricingSettings {
  id                    String   @id @default(cuid())
  supplier              String   @default("SanMar")
  decorationMethod      String   @default("DTF")
  dtfCostPerSqft        Float    @default(4)
  laborPerLocation      Float    @default(2)
  setupFeePerLocation   Float    @default(0)
  shippingPercent       Float    @default(0)
  wastePercent          Float    @default(5)
  defaultProfitMargin   Float    @default(50)
  minimumUnitPrice      Float    @default(0)
  quantityMargins       Json     @default("[]")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  dtfGap                Float    @default(0.25)
  dtfPricingMethod      String   @default("GANG_SHEET")
  dtfRollWidth          Float    @default(22)
  dtfShippingFlat       Float    @default(0)
  gangSheets            Json     @default("[]")
  minimumOrderPrice     Float    @default(0)
  minimumSetupFee       Float    @default(0)
  pricingMode           String   @default("MARKUP")
  supplierShippingFlat  Float    @default(0)
  defaultPrintLocations Json     @default("[{\"key\": \"front\", \"name\": \"Front\", \"width\": 3.5, \"height\": 3.5, \"enabled\": true}, {\"key\": \"back\", \"name\": \"Back\", \"width\": 10.5, \"height\": 11, \"enabled\": true}, {\"key\": \"leftSleeve\", \"name\": \"Left Sleeve\", \"width\": 3, \"height\": 3, \"enabled\": false}, {\"key\": \"rightSleeve\", \"name\": \"Right Sleeve\", \"width\": 3, \"height\": 3, \"enabled\": false}, {\"key\": \"longLeftSleeve\", \"name\": \"Long Left Sleeve\", \"width\": 2.5, \"height\": 17, \"enabled\": false}, {\"key\": \"longRightSleeve\", \"name\": \"Long Right Sleeve\", \"width\": 2.5, \"height\": 17, \"enabled\": false}]")

  @@unique([supplier, decorationMethod])
}

enum QuoteRequestStatus {
  NEW
  REVIEWING
  QUOTED
  APPROVED
  REJECTED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

enum JobStatus {
  Pending
  Design
  Production
  Ready
  Delivered
  Proofing
  Cancelled
}
